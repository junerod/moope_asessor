# Copiado/gerado por scripts/docker/up.sh a partir de .env.local
# NÃO commitar .env.docker com secrets reais.

NODE_ENV=production
APP_ENV=development
APP_NAME=moope-assessor
APP_BASE_URL=http://localhost:3010
# PRODUÇÃO (VPS): use sempre o domínio público canônico:
# APP_BASE_URL=https://assessor.moope.com.br
# Nunca deixe localhost em produção — links no WhatsApp quebram.
ASSESSOR_HTTP_PORT=3010

# Dentro da rede Docker o host é "postgres" (não 127.0.0.1)
DATABASE_URL=postgres://assessor:assessor@postgres:5432/moope_assessor

AUTH_JWT_SECRET=change-me-use-at-least-32-chars-secret
AUTH_JWT_TTL_SECONDS=86400
ENCRYPTION_MASTER_KEY=change-me-encryption-master-key-32b!

DEFAULT_TIMEZONE=America/Sao_Paulo
TERMS_VERSION=2026-10-22
PRIVACY_VERSION=2026-09-19

ZERNIO_MOCK=false
ZERNIO_API_URL=https://zernio.com/api/v1
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=
ZERNIO_WEBHOOK_SECRET=change-me-zernio-webhook-secret
ZERNIO_TIMEOUT_MS=20000

AI_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

STORAGE_ROOT=/app/.data/storage
STORAGE_DRIVER=r2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_REGION=auto

EMAIL_PROVIDER=mailserver
MAILSERVER_URL=https://mailserver.moope.com.br
MAILSERVER_API_KEY=
MAILSERVER_FROM=info@info.moope.com.br

WORKER_POLL_MS=500
WORKER_BATCH_SIZE=5
SCHEDULER_POLL_MS=5000
JOB_MAX_ATTEMPTS=5
LOG_LEVEL=info
HEARTBEAT_STALE_SECONDS=30
