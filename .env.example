# MOOPE Meu Assessor — environment template
# Copy to .env.local for Next.js / local scripts.
# Prefer: npm run import:finance-creds  (puxa do moope-finance)

NODE_ENV=development
APP_ENV=development
APP_NAME=moope-assessor
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://assessor:assessor@127.0.0.1:54329/moope_assessor
AUTH_JWT_SECRET=dev-only-change-me-use-32chars-min-secret
AUTH_JWT_TTL_SECONDS=86400
ENCRYPTION_MASTER_KEY=dev-only-encryption-master-key-32b!

DEFAULT_TIMEZONE=America/Sao_Paulo
TERMS_VERSION=2026-10-22
PRIVACY_VERSION=2026-09-19

# Zernio — preferir /admin (API key + escolher número). Env é bootstrap.
ZERNIO_MOCK=true
ZERNIO_API_URL=https://zernio.com/api/v1
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=
ZERNIO_WEBHOOK_SECRET=dev-zernio-webhook-secret
ZERNIO_TIMEOUT_MS=20000

# OpenAI — preferir /admin (criptografado no banco). Env é bootstrap/fallback.
AI_PROVIDER=heuristic
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage
STORAGE_ROOT=.data/storage
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# Email — mailserver MOOPE (mesmo do finance). Preferir /admin.
EMAIL_PROVIDER=mock
MAILSERVER_URL=https://mailserver.moope.com.br
MAILSERVER_API_KEY=
MAILSERVER_FROM=info@info.moope.com.br

MAX_DOCUMENT_SIZE_BYTES=15000000
MAX_IMAGE_SIZE_BYTES=8000000
MAX_AUDIO_SIZE_BYTES=10000000
HEARTBEAT_STALE_SECONDS=30

WORKER_POLL_MS=500
WORKER_BATCH_SIZE=5
SCHEDULER_POLL_MS=5000
JOB_MAX_ATTEMPTS=5
LOG_LEVEL=info
