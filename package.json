    "jose": "^6.0.12",
    "luxon": "^3.7.2",
    "next": "^15.5.2",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "zod": "^4.1.5"
