    "scheduler": "tsx src/scheduler/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:zernio:smoke": "tsx scripts/zernio-smoke.ts",
    "smoke:openai": "tsx scripts/smoke.ts openai",
    "smoke:zernio": "tsx scripts/smoke.ts zernio",
    "smoke:email": "tsx scripts/smoke.ts email",
    "smoke:vision": "tsx scripts/smoke.ts vision",
    "smoke:transcription": "tsx scripts/smoke.ts transcription",
    "smoke:all": "tsx scripts/smoke.ts all",
    "smoke:reminder": "tsx scripts/smoke-reminder-pipeline.ts",
